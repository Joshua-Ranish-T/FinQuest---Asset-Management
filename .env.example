# FinQuest — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase (Optional) ───────────────────────────────────────────────────
# Leave blank to use local file-based persistence (data/finquest-store.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Session Signing ───────────────────────────────────────────────────────
# Secret key for HMAC-SHA256 session token signing.
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-value

# ─── Local Persistence ─────────────────────────────────────────────────────
# Path to the local JSON data store (used when Supabase is not configured)
# Defaults to: <project-root>/data/finquest-store.json
DATA_STORE_PATH=

# ─── App URL (used for OAuth redirect URIs) ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
